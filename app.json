{
  "expo": {
    "name": "Immersia 360",
    "slug": "immersia-360",
    "scheme": "immersia360",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#111110",
    "ios": {
      "bundleIdentifier": "com.immersiavr.immersia360",
      "supportsTablet": true,
      "requireFullScreen": true,
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "UIStatusBarStyle": "UIStatusBarStyleLightContent"
      }
    },
    "android": {
      "package": "com.immersiavr.immersia360",
      "adaptiveIcon": {
        "backgroundColor": "#111110",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 120,
          "resizeMode": "contain",
          "backgroundColor": "#111110"
        }
      ],
      "expo-sqlite",
      "expo-video",
      [
        "expo-audio",
        {
          "microphonePermission": "Immersia 360 does not record sound. Your videos use the music you choose.",
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": false
        }
      ],
      "expo-sharing",
      "expo-image",
      [
        "expo-camera",
        {
          "cameraPermission": "Immersia 360 uses the camera to record the 360 videos your guests take at the booth.",
          "microphonePermission": "Immersia 360 does not record sound. Your videos use the music you choose.",
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Immersia 360 opens your photo library so you can pick overlay frames.",
          "savePhotosPermission": "Immersia 360 saves the videos you choose to your Photos.",
          "granularPermissions": ["photo", "video"]
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Immersia 360 opens your photo library so you can pick overlay frames.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      ["expo-screen-orientation", { "initialOrientation": "PORTRAIT_UP" }]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
