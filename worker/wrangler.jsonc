{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "immersia-360",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "observability": { "enabled": true },

  "r2_buckets": [{ "binding": "VIDEOS", "bucket_name": "immersia-360-videos" }],

  "durable_objects": {
    "bindings": [{ "name": "HUB", "class_name": "BoothHub" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["BoothHub"] }],

  // R2_ACCOUNT_ID is not secret, but it is yours: fill it in (see README.md).
  // The three secrets are set with `npx wrangler secret put <NAME>` and never live in this file.
  "vars": {
    "R2_ACCOUNT_ID": "",
    "R2_BUCKET_NAME": "immersia-360-videos",
  },
  "secrets": { "required": ["SHARING_KEY", "R2_ACCESS_KEY_ID", "R2_SECRET_ACCESS_KEY"] },
}
